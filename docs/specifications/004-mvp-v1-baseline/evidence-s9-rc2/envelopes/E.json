  "localEffects": [
    "Work Item/workflow state under /Users/rgomids/Projects/axiom-t24-rc2-lab/journey/state and /Users/rgomids/Projects/axiom-t24-rc2-lab/journey/projects",
    "local branch/commit in /Users/rgomids/Projects/axiom-t24-rc2-lab/journey/workspaces/integration"
  ],
  "externalEffects": [
    "1 Issue in rgomids/axiom",
    "axiom:stage:* label creation (if absent) and label changes on that Issue only",
    "at most one provenance-marked comment per projected Execution revision on that Issue",
    "1 remote branch t24-rc2/dogfood-retire-synthetic-ubuntu-row",
    "1 PR to main"
  ],
  "forbiddenEffects": [
    "merge, approve, close or reopen any PR/Issue",
    "Issue closure or human-acceptance fact",
    "force-push or ref deletion",
    "labels/comments on any other Issue/PR",
    "release, tag or promotion",
    "edits to PR #121 or other PRs",
    "credential read/copy/print",
    "workflow completion gate (after human review only)"
