{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario 002 unexpected findings review",
  "type": "object",
  "additionalProperties": false,
  "required": ["methodology", "reviews"],
  "properties": {
    "methodology": { "type": "string", "minLength": 1 },
    "reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approach",
        "finding_id",
        "original_category",
        "subject",
        "classification",
        "rationale",
        "evidence",
        "reviewer"
      ],
      "properties": {
        "approach": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "original_category": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": [
            "valid_additional_finding",
            "false_positive",
            "out_of_scope_observation",
            "duplicate",
            "unclassified"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewer": {
          "enum": ["human-review-required", "experiment-review"]
        }
      }
    }
  }
}
