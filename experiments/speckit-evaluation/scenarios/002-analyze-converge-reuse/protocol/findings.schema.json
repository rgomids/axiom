{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axiom neutral analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approach",
    "artifacts_consulted",
    "interactions",
    "human_decisions_needed",
    "limitations",
    "findings"
  ],
  "properties": {
    "approach": { "type": "string" },
    "artifacts_consulted": {
      "type": "array",
      "items": { "type": "string" }
    },
    "interactions": { "type": "integer" },
    "human_decisions_needed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "artifact",
        "evidence",
        "subject_reference",
        "requirement_reference",
        "recommendation",
        "confidence",
        "human_decision_required"
      ],
      "properties": {
        "id": { "type": "string" },
        "severity": {
          "enum": ["blocker", "critical", "major", "minor", "note"]
        },
        "category": {
          "enum": [
            "requirement_coverage",
            "task_coverage",
            "contradiction",
            "unsupported_behavior",
            "missing_decision",
            "unverifiable_acceptance"
          ]
        },
        "artifact": { "type": "string" },
        "evidence": { "type": "string" },
        "subject_reference": { "type": "string" },
        "requirement_reference": { "type": ["string", "null"] },
        "recommendation": { "type": "string" },
        "confidence": { "type": "number" },
        "human_decision_required": { "type": "boolean" }
      }
    }
  }
}
