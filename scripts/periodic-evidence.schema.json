{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axiom periodic evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "workflow",
    "run_id",
    "run_attempt",
    "run_url",
    "timestamp",
    "branch",
    "subject_sha",
    "layer",
    "scenario",
    "baseline_digest",
    "status",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "workflow": {
      "const": "periodic-monitoring"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "run_attempt": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "run_url": {
      "type": "string",
      "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "branch": {
      "const": "main"
    },
    "subject_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "layer": {
      "enum": [
        "daily",
        "weekly"
      ]
    },
    "scenario": {
      "enum": [
        "live",
        "clean",
        "drift",
        "infrastructure",
        "security"
      ]
    },
    "baseline_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "component",
          "contract",
          "status",
          "category",
          "fingerprint",
          "duration_seconds",
          "tool_version",
          "baseline",
          "observed",
          "reproduction",
          "diagnostics"
        ],
        "properties": {
          "check": {
            "enum": [
              "security",
              "tidy",
              "integrity",
              "cli",
              "simulation"
            ]
          },
          "component": {
            "enum": [
              "go",
              "govulncheck",
              "gh",
              "codex",
              "claude"
            ]
          },
          "contract": {
            "enum": [
              "",
              "version",
              "root",
              "exec",
              "login",
              "auth",
              "api",
              "issue",
              "adapters",
              "failures",
              "compatibility"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE"
            ]
          },
          "category": {
            "enum": [
              "none",
              "vulnerability",
              "dependency_drift",
              "contract_drift",
              "unsupported_version",
              "malformed_output",
              "missing_binary",
              "nonzero_exit",
              "timeout",
              "network",
              "installation",
              "runner",
              "output_limit",
              "artifact",
              "permission"
            ]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 300
          },
          "tool_version": {
            "type": "string",
            "pattern": "^(unavailable|(go|v)?[0-9]{1,3}[.][0-9]{1,3}([.][0-9]{1,3})?)$"
          },
          "baseline": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(unavailable|[0-9]+[.][0-9]+[.][0-9]+)$"
              },
              {
                "type": "object",
                "maxProperties": 12,
                "additionalProperties": false,
                "properties": {
                  "api": {
                    "type": "boolean"
                  },
                  "issue": {
                    "type": "boolean"
                  },
                  "pr": {
                    "type": "boolean"
                  },
                  "repo": {
                    "type": "boolean"
                  },
                  "--method": {
                    "type": "boolean"
                  },
                  "--input": {
                    "type": "boolean"
                  },
                  "--paginate": {
                    "type": "boolean"
                  },
                  "--jq": {
                    "type": "boolean"
                  },
                  "create": {
                    "type": "boolean"
                  },
                  "edit": {
                    "type": "boolean"
                  },
                  "close": {
                    "type": "boolean"
                  },
                  "reopen": {
                    "type": "boolean"
                  },
                  "view": {
                    "type": "boolean"
                  },
                  "exec": {
                    "type": "boolean"
                  },
                  "login": {
                    "type": "boolean"
                  },
                  "--model": {
                    "type": "boolean"
                  },
                  "--sandbox": {
                    "type": "boolean"
                  },
                  "--json": {
                    "type": "boolean"
                  },
                  "status": {
                    "type": "boolean"
                  },
                  "--print": {
                    "type": "boolean"
                  },
                  "--output-format": {
                    "type": "boolean"
                  },
                  "auth": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "observed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(unavailable|[0-9]+[.][0-9]+[.][0-9]+)$"
              },
              {
                "type": "object",
                "maxProperties": 12,
                "additionalProperties": false,
                "properties": {
                  "api": {
                    "type": "boolean"
                  },
                  "issue": {
                    "type": "boolean"
                  },
                  "pr": {
                    "type": "boolean"
                  },
                  "repo": {
                    "type": "boolean"
                  },
                  "--method": {
                    "type": "boolean"
                  },
                  "--input": {
                    "type": "boolean"
                  },
                  "--paginate": {
                    "type": "boolean"
                  },
                  "--jq": {
                    "type": "boolean"
                  },
                  "create": {
                    "type": "boolean"
                  },
                  "edit": {
                    "type": "boolean"
                  },
                  "close": {
                    "type": "boolean"
                  },
                  "reopen": {
                    "type": "boolean"
                  },
                  "view": {
                    "type": "boolean"
                  },
                  "exec": {
                    "type": "boolean"
                  },
                  "login": {
                    "type": "boolean"
                  },
                  "--model": {
                    "type": "boolean"
                  },
                  "--sandbox": {
                    "type": "boolean"
                  },
                  "--json": {
                    "type": "boolean"
                  },
                  "status": {
                    "type": "boolean"
                  },
                  "--print": {
                    "type": "boolean"
                  },
                  "--output-format": {
                    "type": "boolean"
                  },
                  "auth": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "reproduction": {
            "type": "string",
            "maxLength": 256
          },
          "diagnostics": {
            "const": "manifest.json"
          },
          "tests": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "test",
                "status"
              ],
              "properties": {
                "test": {
                  "type": "string",
                  "pattern": "^Test[A-Za-z0-9_]+$"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "SKIP"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
