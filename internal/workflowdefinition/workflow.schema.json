{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:workflow-definition:1",
  "title": "Proposed Axiom workflow definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "revision",
    "name",
    "stages"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "instructions",
          "phase",
          "checkpoint",
          "mode",
          "concurrency",
          "inputs",
          "outputs",
          "completionCriteria",
          "validators",
          "humanGates",
          "failurePolicy",
          "agents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "phase": {
            "type": "string",
            "enum": [
              "intake",
              "specification",
              "planning",
              "implementation",
              "review",
              "completion"
            ]
          },
          "checkpoint": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "sequential",
              "dag"
            ]
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "source",
                "required"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "work-item",
                    "project-context",
                    "artifact",
                    "stage-output"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "required"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "artifact",
                    "evidence",
                    "decision",
                    "result"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "completionCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "description",
                "outputRef",
                "validatorRef"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "outputRef": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "validatorRef": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            }
          },
          "validators": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "policyRef"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "artifact-schema",
                    "evidence-check",
                    "human-review"
                  ]
                },
                "policyRef": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            }
          },
          "humanGates": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "timing"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "planning_authority",
                    "implementation_authority",
                    "review_started",
                    "human_acceptance"
                  ]
                },
                "timing": {
                  "type": "string",
                  "enum": [
                    "before",
                    "after"
                  ]
                }
              }
            }
          },
          "failurePolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "onFailure",
              "onUnknown",
              "retry"
            ],
            "properties": {
              "onFailure": {
                "type": "string",
                "enum": [
                  "block"
                ]
              },
              "onUnknown": {
                "type": "string",
                "enum": [
                  "reconcile"
                ]
              },
              "retry": {
                "type": "string",
                "enum": [
                  "explicit"
                ]
              }
            }
          },
          "agents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "role",
                "responsibilities",
                "complexity",
                "dependsOn",
                "inputs",
                "outputs",
                "capabilities",
                "runtimeConstraints",
                "profileRef",
                "effort",
                "timeoutSeconds",
                "maximumAttempts",
                "effectCeilings",
                "integrationOwner",
                "validationOwner"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "role": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "responsibilities": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "dependsOn": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                },
                "inputs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                },
                "outputs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                },
                "capabilities": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                },
                "runtimeConstraints": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "enum": [
                      "codex",
                      "claude"
                    ]
                  }
                },
                "profileRef": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "effort": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "value"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "runtime-default",
                        "explicit"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    }
                  }
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "maximumAttempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "effectCeilings": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "enum": [
                      "read",
                      "repository-write",
                      "process",
                      "artifact-publish",
                      "integration"
                    ]
                  }
                },
                "integrationOwner": {
                  "type": "boolean"
                },
                "validationOwner": {
                  "type": "boolean"
                },
                "complexity": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
